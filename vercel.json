{
  "buildCommand": "IS_VERCEL=true npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/((?!assets/|vite\\.svg|favicon\\.ico|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
